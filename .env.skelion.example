# Example environment configuration for Skelion
# -------------------------------------------------
# Comma‑separated list of API keys used by the shared key‑pool.
# You can include keys for OpenAI, Anthropic, Gemini, etc.
OPENAI_API_KEYS=sk-xxxxxx,sk-yyyyyy

# SQLModel / SQLAlchemy database URL (default uses a local SQLite file)
DATABASE_URI=sqlite:///./skelion.db

# Redis connection (used for caching and Prometheus counters)
REDIS_URI=redis://localhost:6379/0

# JWT configuration for authentication
JWT_SECRET_KEY=dev-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay credentials (test placeholders)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Optional: provider‑specific keys if you decide to separate pools later
# ANTHROPIC_API_KEYS=...
# GEMINI_API_KEYS=...
# OLLAMA_BASE_URL=http://localhost:11434

# Any other custom configuration can be added here.
# -------------------------------------------------
