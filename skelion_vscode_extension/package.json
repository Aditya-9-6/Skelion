{
  "name": "skelion-vscode",
  "publisher": "AdityaDnyaneshwarDahale",
  "displayName": "Skelion Agent",
  "icon": "media/icon.png",
  "description": "Autonomous AI engineering, real-time incident remediation, live zero-restart billing & MCP agent platform",
  "version": "0.1.2",
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "skelion",
    "autonomous",
    "incident",
    "autofix",
    "mcp",
    "ai-agent",
    "telemetry"
  ],
  "engines": {
    "vscode": "^1.88.0"
  },
  "activationEvents": [
    "onCommand:skelion.openPanel",
    "onView:dashboard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "skelion.openPanel",
        "title": "Skelion: Open Dashboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skelion",
          "title": "Skelion",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "skelion": [
        {
          "type": "webview",
          "id": "dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "configuration": {
      "title": "Skelion",
      "properties": {
        "skelion.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Optional custom Skelion backend or Render URL (e.g. https://skelion.onrender.com). If empty, auto-detects local server."
        }
      }
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "lint": "tsc --noEmit",
    "e2e": "bash ./scripts/e2e-test.sh",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aditya-9-6/Skelion.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "2.24.0"
  }
}
