{
  "name": "skelion-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "test:unit": "node --experimental-strip-types --test src/components/VerificationBadge.test.ts",
    "test:coverage": "npx c8 node --experimental-strip-types --test src/components/VerificationBadge.test.ts && node scripts/export_coverage.js",
    "test:c8": "npx c8 node --experimental-strip-types --test src/components/VerificationBadge.test.ts",
    "test:jest": "jest --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "micromatch": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "c8": "^10.1.2",
    "jest": "^29.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
