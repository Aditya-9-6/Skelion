{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/auth/github", "destination": "/api/auth/github.js" },
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/api/repos", "destination": "/api/repos.js" },
    { "source": "/api/billing", "destination": "/api/billing.js" },
    { "source": "/api/receipt", "destination": "/api/receipt.js" },
    { "source": "/api/rates", "destination": "/api/rates.js" },
    { "source": "/dashboard/me", "destination": "/api/dashboard_me.js" },
    { "source": "/api/dashboard/me", "destination": "/api/dashboard_me.js" }
  ]
}
