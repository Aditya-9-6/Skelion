{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkelionHybridEgressContract",
  "description": "Strict allow-list schema governing all metadata transmitted to Skelion Cloud in Hybrid mode. Zero PII, bodies, headers, or source code allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "service_name",
    "error_fingerprint",
    "http_status",
    "route_template",
    "severity",
    "count"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "release_version": {
      "type": "string"
    },
    "error_fingerprint": {
      "type": "string",
      "description": "One-way cryptographic SHA-256 hash of error signature. Raw stack trace text is never transmitted."
    },
    "error_class": {
      "type": "string"
    },
    "http_status": {
      "type": "integer"
    },
    "route_template": {
      "type": "string",
      "description": "Normalized route template with dynamic IDs and UUIDs replaced by :id"
    },
    "latency_bucket": {
      "type": "string",
      "enum": ["<50ms", "50-200ms", "200-500ms", "500-1000ms", ">1000ms"]
    },
    "count": {
      "type": "integer"
    },
    "first_seen": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "fix_status": {
      "type": "string",
      "enum": ["pending", "verified", "merged", "dismissed"]
    }
  }
}
