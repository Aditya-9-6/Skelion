# Non-secret production configuration. Inject secrets through your deployment
# secret manager; do not commit a populated .env.production file.
PROJECT_NAME=Skelion Unified Autonomous Platform
VERSION=1.0.0-unified
API_V1_STR=/api/v1
ENVIRONMENT=production
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8002
EDGE_PROXY_HOST=0.0.0.0
EDGE_PROXY_PORT=8080
UPSTREAM_URL=http://127.0.0.1:8000

SECRET_KEY=REPLACE_IN_SECRET_MANAGER
ENCRYPTION_KEY=REPLACE_IN_SECRET_MANAGER
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true

RAZORPAY_KEY_ID=rzp_live_REPLACE
RAZORPAY_KEY_SECRET=REPLACE_IN_SECRET_MANAGER
RAZORPAY_WEBHOOK_SECRET=REPLACE_IN_SECRET_MANAGER
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
GITHUB_APP_ID=REPLACE
GITHUB_WEBHOOK_SECRET=REPLACE_IN_SECRET_MANAGER
GITHUB_PRIVATE_KEY=

DEFAULT_MONTHLY_QUOTA=1000
ERROR_RATE_THRESHOLD=0.25
PROVIDER_KEYS_JSON=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
